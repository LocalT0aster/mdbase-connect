POSTGRES_DB=mdbase_connect
POSTGRES_USER=mdbase
POSTGRES_PASSWORD=replace-this-password
PUBLIC_URL=http://localhost:8787
# Development identity is intentionally not suitable for a public deployment.
MDBASE_CONNECT_DEV_AUTH=1

# Public deployments set MDBASE_CONNECT_DEV_AUTH=0 and configure exactly one
# identity provider. GitHub sign-in is restricted by immutable numeric account
# IDs rather than mutable usernames.
# MDBASE_CONNECT_GITHUB_CLIENT_ID=
# MDBASE_CONNECT_GITHUB_CLIENT_SECRET=
# MDBASE_CONNECT_ALLOWED_GITHUB_USER_IDS=12558714

# Leave hosted collection routes unavailable during the relay-only preview.
MDBASE_CONNECT_HOSTED_COLLECTIONS=0

# Enable only behind a trusted reverse proxy such as Render.
MDBASE_CONNECT_TRUST_PROXY=0
