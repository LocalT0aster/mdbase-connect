{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mdbase.dev/connect/schemas/mdbase-app.v1.json",
  "title": "MDBASE Connect application manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_version", "name", "homepage", "redirect_uris"],
  "properties": {
    "manifest_version": { "const": 1 },
    "name": { "type": "string", "minLength": 1, "maxLength": 100 },
    "homepage": { "type": "string", "format": "uri", "pattern": "^https://" },
    "icon": { "type": "string", "format": "uri", "pattern": "^https://" },
    "redirect_uris": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "format": "uri", "pattern": "^https://" }
    }
  }
}

